import java.util.Random;

public class QuickSort<T extends Comparable<T>> {
    private T[] array;
    private boolean descending = false;
    private boolean useMiddlePivot = false;
    private boolean useRandomPivot = false;

    public QuickSort(T[] array) {
        this.array = array.clone();
    }

    // Для завдань 1, 2, 3
    public QuickSort(T[] array, boolean descending, boolean useMiddlePivot, boolean useRandomPivot) {
        this.array = array.clone();
        this.descending = descending;
        this.useMiddlePivot = useMiddlePivot;
        this.useRandomPivot = useRandomPivot;
    }

    public T[] getArray() {
        return array;
    }

    public void quickSortArray(int first, int last) {
        if (first < last) {
            int pivotIndex = getPivotIndex(first, last);
            swap(pivotIndex, last); // ставимо обраний елемент як опорний
            int partitionIndex = partition(first, last);
            quickSortArray(first, partitionIndex - 1);
            quickSortArray(partitionIndex + 1, last);
        }
    }

    private int getPivotIndex(int first, int last) {
        if (useRandomPivot) {
            return first + new Random().nextInt(last - first + 1);
        } else if (useMiddlePivot) {
            return first + (last - first) / 2;
        } else {
            return last; // за замовчуванням — останній елемент
        }
    }

    private int partition(int first, int last) {
        T pivotElement = array[last];
        int i = first - 1;
        for (int j = first; j < last; j++) {
            int comparison = array[j].compareTo(pivotElement);
            boolean condition = descending ? (comparison >= 0) : (comparison <= 0);
            if (condition) {
                i++;
                if (i != j) {
                    swap(i, j);
                }
            }
        }
        swap(i + 1, last);
        return i + 1;
    }

    private void swap(int i, int j) {
        T temp = array[i];
        array[i] = array[j];
        array[j] = temp;
    }
}
