import java.util.Random;

public class QuickSortTimingComparison {

    public static void main(String[] args) {
        Integer[] array = generateRandomArray();

        measure("Останній елемент", array, false, false);
        measure("Середній елемент", array, true, false);
        measure("Випадковий елемент", array, false, true);
    }

    private static void measure(String label, Integer[] baseArray, boolean middle, boolean random) {
        Integer[] copy = baseArray.clone();
        QuickSort<Integer> sorter = new QuickSort<>(copy, false, middle, random);

        long start = System.nanoTime();
        sorter.quickSortArray(0, copy.length - 1);
        long end = System.nanoTime();

        System.out.println(label + ": " + (end - start) + " нс");
    }

    private static Integer[] generateRandomArray() {
        Random rand = new Random();
        Integer[] array = new Integer[10000];
        for (int i = 0; i < 10000; i++) {
            array[i] = rand.nextInt(10000);
        }
        return array;
    }
}
